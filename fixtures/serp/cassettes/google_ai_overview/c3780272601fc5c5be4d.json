        {
          "type": "list",
          "list": [
            {
              "snippet": "Optimum Nutrition Gold Standard 100% Whey: यह दुनिया भर में सबसे लोकप्रिय और भरोसेमंद ब्रांड है। इसमें उच्च गुणवत्ता वाला व्हे प्रोटीन ब्लेड और आइसोलेट मिलता है, जो पचने में आसान होता है और मांसपेशियों की रिकवरी तेजी से करता है।",
              "reference_indexes": [
                1
              ]
