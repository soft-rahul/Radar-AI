# Copy to .env and fill in. .env is gitignored and must never be committed.
SERPAPI_KEY=
GEMINI_API_KEY=
# gemini-2.5-flash is closed to new keys; 3.5-flash works on the free tier (fallback: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash

# live = call SerpApi · record = call and save cassettes · replay = offline, cassettes only
SERPAPI_MODE=replay
# Hard ceiling on SerpApi searches per scan
MAX_SEARCHES=120
